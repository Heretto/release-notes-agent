# ── Docker Compose environment ───────────────────────────────────────────────
#
# Copy to .env (gitignored) and fill in. Docker Compose reads THIS file at the
# repository root to substitute ${VAR} references in docker-compose.yml.
#
# There are three environment files in this repo and they are not interchangeable:
#
#   .env                     → docker compose (this file's shape). Used by `docker compose up`.
#   backend/.env             → local uvicorn/celery runs outside Docker (dev.sh, install.sh).
#                              See backend/.env.example. It carries DATABASE_URL and REDIS_URL
#                              pointing at localhost; compose sets those inline instead.
#   .env.production          → production compose. See .env.production.example.
#
# Keep the secrets consistent across whichever of these you use on one machine —
# in particular ENCRYPTION_KEY (see the warning below).

# ── Required secrets ─────────────────────────────────────────────────────────
# Compose fails loudly if these are unset rather than falling back to a shared
# development default. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

APP_SECRET_KEY=
JWT_SECRET_KEY=

# WARNING: ENCRYPTION_KEY derives the Fernet cipher for stored credentials, and it is
# NOT ROTATABLE. Changing it makes every already-encrypted row permanently unreadable.
# Minimum 16 characters. Back it up somewhere safe and never commit it.
ENCRYPTION_KEY=

# ── AI providers ─────────────────────────────────────────────────────────────
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# ── Integrations ─────────────────────────────────────────────────────────────
JIRA_WEBHOOK_SECRET=
HERETTO_BASE_URL=https://api.heretto.com

# ── Email (Mailpit runs in compose on port 1025; UI at http://localhost:8025) ─
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@release-notes.local
SMTP_USE_TLS=false
FRONTEND_BASE_URL=http://localhost:4200

# ── SSO (optional) ───────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
OAUTH_REDIRECT_BASE_URL=http://localhost:4200

# ── Test credentials (not used by the running app) ───────────────────────────
TEST_CLAUDE_API_KEY=
TEST_CLAUDE_MODEL=claude-haiku-4-5-20251001
TEST_OPENAI_API_KEY=
TEST_OPENAI_MODEL=gpt-4o-mini
TEST_GOOGLE_MODEL=gemini-2.0-flash
