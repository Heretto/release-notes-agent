# Production Environment Configuration
# Copy this file to .env.production and fill in your values.
#
# Read by docker-compose.production.yml. DATABASE_URL and REDIS_URL are not set here —
# that compose file builds them from POSTGRES_* and REDIS_PASSWORD below.
# For local development use the repository-root .env (compose) or backend/.env (host).

# Database Configuration
POSTGRES_USER=produser
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
POSTGRES_DB=release_notes_production

# Redis Configuration  
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Application Secrets (generate with: openssl rand -hex 32)
APP_SECRET_KEY=GENERATE_NEW_SECRET_KEY
JWT_SECRET_KEY=GENERATE_NEW_JWT_KEY

# WARNING: ENCRYPTION_KEY is NOT ROTATABLE. It derives the Fernet cipher for stored
# credentials, so changing it makes every already-encrypted row permanently unreadable.
# Minimum 16 characters. Back it up securely and keep it out of version control.
ENCRYPTION_KEY=GENERATE_NEW_ENCRYPTION_KEY

# Google AI Studio
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Jira Configuration
JIRA_WEBHOOK_SECRET=your-jira-webhook-secret

# Heretto Configuration
HERETTO_BASE_URL=https://api.heretto.com

# API URL (for frontend build)
API_URL=https://your-domain.com/api

# SSL Email (for Let's Encrypt)
SSL_EMAIL=admin@your-domain.com

# Domain Names
# Include the scheme — CORS origins are matched literally against the browser's Origin
# header, so a bare hostname never matches. Comma-separate multiple origins.
DOMAIN=your-domain.com                              #example: releasenotes.herettoopenprojects.ai
CORS_ORIGINS=https://your-domain.com                #example: https://releasenotes.herettoopenprojects.ai
FRONTEND_BASE_URL=https://your-domain.com           #example: https://releasenotes.herettoopenprojects.ai


#SSO Configuration
SSO_ONLY=false

## Google OAuth
#GOOGLE_OAUTH_CLIENT_ID=

## Microsoft OAuth
#MICROSOFT_OAUTH_CLIENT_ID=your-client-id                  
#MICROSOFT_OAUTH_CLIENT_SECRET=your-client-secret                                                                                                                                                                                                                                                
#MICROSOFT_OAUTH_TENANT_ID=common        # or your specific tenant ID                                                                                                                                                                                                                            
#OAUTH_REDIRECT_BASE_URL=http://localhost:8000


# OPTIONAL -- STMP Configuration (for email notifications)
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USERNAME=user@gmail.com
#SMTP_PASSWORD=app-password
#SMTP_FROM_EMAIL=noreply@mycompany.com
#SMTP_USE_TLS=true



######
# TESTING CREDENTIALS - these are not used in production, only for testing purposes

# Jira
TEST_JIRA_URL=https://your-domain.atlassian.net
TEST_JIRA_USERNAME=test-user
TEST_JIRA_API_TOKEN=your-jira-api-token

# Heretto
TEST_HERETTO_LOGIN_USER=your-heretto-login-email
TEST_HERETTO_LOGIN_TOKEN=your-heretto-login-token


# Claude 
TEST_CLAUDE_API_KEY=your-test-claude-api-key
TEST_CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI
TEST_OPENAI_API_KEY=your-test-openai-api-key
TEST_OPENAI_MODEL=gpt-4o